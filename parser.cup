package minilang;
import java_cup.runtime.*;

/* ── Clase puente accesible desde action code y parser code ── */
action code {:

    // Referencia directa a las listas — se inicializan en parser code
    private static java.util.List<String> _errSem =
        new java.util.ArrayList<>();

    void errorSemantico(String msg) {
        minilang.CupHelper.agregarError("[ERROR SEMANTICO] " + msg);
    }

    boolean compatibles(String t1, String t2) {
        if (t1 == null || t2 == null)  return true;
        if (t1.equals(t2))             return true;
        if (t1.equals("decimal") && t2.equals("num")) return true;
        if (t1.equals("error") || t2.equals("error")) return true;
        return false;
    }
:}

parser code {:
    private java.util.List<String> erroresSintacticos = new java.util.ArrayList<>();
    private int    ultimaLinea   = 0;
    private int    ultimaColumna = 0;
    private String ultimoLexema  = "";

    public java.util.List<String> getErroresSintacticos() {
        return erroresSintacticos;
    }

    public java.util.List<String> getErroresSemanticos() {
        return minilang.CupHelper.getErroresSemanticos();
    }

    public void rastrearToken(minilang.Token t) {
        if (t != null) {
            ultimaLinea   = t.getLinea();
            ultimaColumna = t.getColumna();
            ultimoLexema  = t.getLexema();
        }
    }

    @Override
    public void report_error(String message, Object info) {
        StringBuilder msg = new StringBuilder("[ERROR SINTACTICO]");
        if (info instanceof java_cup.runtime.Symbol) {
            java_cup.runtime.Symbol s = (java_cup.runtime.Symbol) info;
            if (s.value instanceof minilang.Token) {
                minilang.Token t = (minilang.Token) s.value;
                msg.append(" Linea ").append(t.getLinea())
                   .append(", Columna ").append(t.getColumna())
                   .append(": token inesperado '").append(t.getLexema()).append("'");
            } else if (ultimaLinea > 0) {
                msg.append(" cerca de la linea ").append(ultimaLinea)
                   .append(", columna ").append(ultimaColumna)
                   .append(": token inesperado '").append(ultimoLexema).append("'");
            } else {
                msg.append(" ").append(message);
            }
        } else if (ultimaLinea > 0) {
            msg.append(" cerca de la linea ").append(ultimaLinea)
               .append(", columna ").append(ultimaColumna)
               .append(": token inesperado '").append(ultimoLexema).append("'");
        } else {
            msg.append(" ").append(message);
        }
        erroresSintacticos.add(msg.toString());
    }

    @Override
    public void report_fatal_error(String message, Object info) {
        report_error(message, info);
        throw new RuntimeException("Error sintactico irrecuperable");
    }
:}

/* ── Terminales ── */
terminal PR_PROGRAMA, PR_NUM, PR_DECIMAL, PR_TEXTO;
terminal PR_LETRA, PR_LOGICO, PR_CIERTO, PR_FALSO;
terminal PR_MOSTRAR, PR_SI, PR_SINO, PR_MIENTRAS;
terminal ABRE_BLOQUE, CIERRA_BLOQUE;
terminal IGUAL_IGUAL, DIFERENTE, MAYOR_IGUAL, MENOR_IGUAL, MAYOR, MENOR;
terminal ASIGNACION;
terminal SUMA, RESTA, MULT, DIV, POTENCIA;
terminal PAR_IZQ, PAR_DER, PUNTO_COMA, COMA;
terminal ENTERO_LITERAL, REAL_LITERAL, STRING_LITERAL, CHAR_LITERAL;
terminal String ID;

/* ── No terminales ── */
non terminal          programa;
non terminal          lista_sentencias;
non terminal          sentencia;
non terminal          declaracion;
non terminal          condicion;
non terminal          ciclo;
non terminal          impresion;
non terminal          asignacion;
non terminal String   tipo;
non terminal String   expresion;
non terminal String   termino;
non terminal String   factor;
non terminal String   expresion_rel;

/* ── Precedencia ── */
precedence left SUMA, RESTA;
precedence left MULT, DIV;
precedence right POTENCIA;

start with programa;

/* ══════════════════════════════════════════════════════════════
   REGLAS GRAMATICALES
   ══════════════════════════════════════════════════════════════ */

programa ::= PR_PROGRAMA ID:nombre ABRE_BLOQUE
             {:
                 // Registrar nombre del programa ANTES de procesar sentencias
                 TablaSimbolos ts = TablaSimbolos.getInstance();
                 ts.agregar(nombre,
                     new Token(TipoToken.ID, nombre, 0, 0), "programa");
             :}
             lista_sentencias CIERRA_BLOQUE
             {:
                 // Verificar R10: nadie declaró una variable con ese nombre
                 TablaSimbolos ts = TablaSimbolos.getInstance();
                 String tipo = ts.getTipo(nombre);
                 if (tipo != null && !tipo.equals("programa")) {
                     minilang.CupHelper.agregarError(
                         "[ERROR SEMANTICO] '" + nombre +
                         "' es el nombre del programa y no puede" +
                         " usarse como variable.");
                 }
             :}
           ;

lista_sentencias ::= lista_sentencias sentencia
                   | /* vacia */
                   ;

sentencia ::= declaracion
            | asignacion
            | condicion
            | ciclo
            | impresion
            | error PUNTO_COMA
            ;

/* ── Declaracion ── */
declaracion ::= tipo:t ID:nombre PUNTO_COMA
                {:
                    TablaSimbolos ts = TablaSimbolos.getInstance();
                    Token tokReal = ts.getToken(nombre);
                    if (tokReal == null)
                        tokReal = new Token(TipoToken.ID, nombre, 0, 0);

                    if (ts.existe(nombre) &&
                        !"desconocido".equals(ts.getTipo(nombre))) {
                        minilang.CupHelper.agregarError(
                            "[ERROR SEMANTICO] Variable '" + nombre +
                            "' ya fue declarada anteriormente.");
                    } else {
                        ts.agregar(nombre, tokReal, t);
                    }
                :}
              ;

tipo ::= PR_NUM     {: RESULT = "num";     :}
       | PR_DECIMAL {: RESULT = "decimal"; :}
       | PR_TEXTO   {: RESULT = "texto";   :}
       | PR_LETRA   {: RESULT = "letra";   :}
       | PR_LOGICO  {: RESULT = "logico";  :}
       ;

/* ── Asignacion ── */
asignacion ::= ID:nombre ASIGNACION expresion:te PUNTO_COMA
               {:
                   TablaSimbolos ts = TablaSimbolos.getInstance();
                   if (!ts.existe(nombre) ||
                       ts.getTipo(nombre).equals("desconocido")) {
                       errorSemantico("Variable '" + nombre +
                           "' usada sin declarar.");
                   } else {
                       String tv = ts.getTipo(nombre);
                       if (!compatibles(tv, te)) {
                           errorSemantico("Tipos incompatibles: no se puede" +
                               " asignar '" + te + "' a '" + nombre +
                               "' de tipo '" + tv + "'.");
                       }
                   }
               :}
             ;
/* ── Condicional ── */
condicion ::= PR_SI PAR_IZQ expresion_rel:tr PAR_DER
              ABRE_BLOQUE lista_sentencias CIERRA_BLOQUE
              {:
                  if (!tr.equals("logico") && !tr.equals("error")) {
                      errorSemantico("Condicion del 'si' debe ser logico," +
                          " se obtuvo '" + tr + "'.");
                  }
              :}
            | PR_SI PAR_IZQ expresion_rel:tr PAR_DER
              ABRE_BLOQUE lista_sentencias CIERRA_BLOQUE
              PR_SINO
              ABRE_BLOQUE lista_sentencias CIERRA_BLOQUE
              {:
                  if (!tr.equals("logico") && !tr.equals("error")) {
                      errorSemantico("Condicion del 'si-sino' debe ser" +
                          " logico, se obtuvo '" + tr + "'.");
                  }
              :}
            ;

/* ── Ciclo ── */
ciclo ::= PR_MIENTRAS PAR_IZQ expresion_rel:tr PAR_DER
          ABRE_BLOQUE lista_sentencias CIERRA_BLOQUE
          {:
              if (!tr.equals("logico") && !tr.equals("error")) {
                  errorSemantico("Condicion del 'mientras' debe ser" +
                      " logico, se obtuvo '" + tr + "'.");
              }
          :}
        ;

/* ── Mostrar ── */
impresion ::= PR_MOSTRAR PAR_IZQ expresion:t PAR_DER PUNTO_COMA
            ;

/* ── Expresiones aritmeticas ── */
expresion ::= expresion:t1 SUMA termino:t2
              {:
                  if (t1.equals("texto") || t2.equals("texto") ||
                      t1.equals("logico") || t2.equals("logico")) {
                      errorSemantico("Operacion '+' invalida entre '" +
                          t1 + "' y '" + t2 + "'.");
                      RESULT = "error";
                  } else {
                      RESULT = (t1.equals("decimal") ||
                                t2.equals("decimal")) ? "decimal" : "num";
                  }
              :}
            | expresion:t1 RESTA termino:t2
              {:
                  if (t1.equals("texto") || t2.equals("texto") ||
                      t1.equals("logico") || t2.equals("logico")) {
                      errorSemantico("Operacion '-' invalida entre '" +
                          t1 + "' y '" + t2 + "'.");
                      RESULT = "error";
                  } else {
                      RESULT = (t1.equals("decimal") ||
                                t2.equals("decimal")) ? "decimal" : "num";
                  }
              :}
            | termino:t {: RESULT = t; :}
            ;

termino ::= termino:t1 MULT factor:t2
            {:
                if (t1.equals("texto") || t2.equals("texto") ||
                    t1.equals("logico") || t2.equals("logico")) {
                    errorSemantico("Operacion '*' invalida entre '" +
                        t1 + "' y '" + t2 + "'.");
                    RESULT = "error";
                } else {
                    RESULT = (t1.equals("decimal") ||
                              t2.equals("decimal")) ? "decimal" : "num";
                }
            :}
          | termino:t1 DIV factor:t2
            {:
                if (t1.equals("texto") || t2.equals("texto") ||
                    t1.equals("logico") || t2.equals("logico")) {
                    errorSemantico("Operacion '/' invalida entre '" +
                        t1 + "' y '" + t2 + "'.");
                    RESULT = "error";
                } else {
                    RESULT = "decimal";
                }
            :}
          | termino:t1 POTENCIA factor:t2
            {: RESULT = "decimal"; :}
          | factor:t {: RESULT = t; :}
          ;

factor ::= PAR_IZQ expresion:t PAR_DER {: RESULT = t; :}
         | ID:nombre
           {:
               TablaSimbolos ts = TablaSimbolos.getInstance();
               if (!ts.existe(nombre)) {
                   errorSemantico("Variable '" + nombre +
                       "' usada sin declarar.");
                   RESULT = "error";
               } else {
                   RESULT = ts.getTipo(nombre);
               }
           :}
         | ENTERO_LITERAL  {: RESULT = "num";    :}
         | REAL_LITERAL    {: RESULT = "decimal"; :}
         | STRING_LITERAL  {: RESULT = "texto";   :}
         | CHAR_LITERAL    {: RESULT = "letra";   :}
         | PR_CIERTO       {: RESULT = "logico";  :}
         | PR_FALSO        {: RESULT = "logico";  :}
         ;

/* ── Expresiones relacionales ── */
expresion_rel ::= expresion:t1 IGUAL_IGUAL expresion:t2
                  {:
                      if (!compatibles(t1,t2) && !compatibles(t2,t1)) {
                          errorSemantico("Comparacion incompatible: '" +
                              t1 + "' == '" + t2 + "'.");
                      }
                      RESULT = "logico";
                  :}
                | expresion:t1 DIFERENTE expresion:t2
                  {:
                      if (!compatibles(t1,t2) && !compatibles(t2,t1)) {
                          errorSemantico("Comparacion incompatible: '" +
                              t1 + "' != '" + t2 + "'.");
                      }
                      RESULT = "logico";
                  :}
                | expresion:t1 MAYOR expresion:t2
                  {:
                      if (t1.equals("texto") || t2.equals("texto") ||
                          t1.equals("logico") || t2.equals("logico")) {
                          errorSemantico("Comparacion '>' invalida entre '" +
                              t1 + "' y '" + t2 + "'.");
                      }
                      RESULT = "logico";
                  :}
                | expresion:t1 MENOR expresion:t2
                  {:
                      if (t1.equals("texto") || t2.equals("texto") ||
                          t1.equals("logico") || t2.equals("logico")) {
                          errorSemantico("Comparacion '<' invalida entre '" +
                              t1 + "' y '" + t2 + "'.");
                      }
                      RESULT = "logico";
                  :}
                | expresion:t1 MAYOR_IGUAL expresion:t2
                  {:
                      if (t1.equals("texto") || t2.equals("texto") ||
                          t1.equals("logico") || t2.equals("logico")) {
                          errorSemantico("Comparacion '>=' invalida entre '" +
                              t1 + "' y '" + t2 + "'.");
                      }
                      RESULT = "logico";
                  :}
                | expresion:t1 MENOR_IGUAL expresion:t2
                  {:
                      if (t1.equals("texto") || t2.equals("texto") ||
                          t1.equals("logico") || t2.equals("logico")) {
                          errorSemantico("Comparacion '<=' invalida entre '" +
                              t1 + "' y '" + t2 + "'.");
                      }
                      RESULT = "logico";
                  :}
                | expresion:t {: RESULT = t; :}
                ;